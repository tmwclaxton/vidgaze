APP_NAME=VidGaze
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_SERVICE=vidgaze

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vidgaze
DB_USERNAME=vidgaze_user
DB_PASSWORD=changemeplz

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD="xxxx xxxx xxxx xxxx"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME=${APP_NAME}

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

DAILYMOTION_CLIENT_KEY=
DAILYMOTION_CLIENT_SECRET=
DAILYMOTION_REDIRECT_URL=

VIMEO_DEVELOPER_KEY=
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
VIMEO_REDIRECT_URL=

# Scraping: self hosted crawl4ai first, paid providers only as fallback
CRAWL4AI_URL=
CRAWL4AI_API_TOKEN=
CRAWL4AI_TIMEOUT=90
CRAWL4AI_PAGE_TIMEOUT_MS=30000
APIFY_TOKEN=
APIFY_FALLBACK_ENABLED=true
APIFY_DAILY_RUN_CAP=20
APIFY_CACHE_MINUTES=360
APIFY_MEMORY_MB=512
APIFY_TIMEOUT_SECS=90
APIFY_MAX_CHARGE_USD=0.05
APIFY_USE_PROXY=false
APIFY_PROXY_GROUPS=
APIFY_RUMBLE_ACTOR=memo23~rumble-scraper
APIFY_RUMBLE_CREATOR_ACTOR=azzouzana~rumble-all-inclusive-scraper
APIFY_RUMBLE_SEARCH_MAX=20
APIFY_RUMBLE_CHANNEL_VIDEOS_MAX=30
APIFY_RUMBLE_CREATORS_MAX=10
# scraper.tech is only used for YouTube if set and crawl4ai fails
SCRAPER_KEY=
