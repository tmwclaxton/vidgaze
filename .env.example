APP_NAME=VidGaze
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_SERVICE=vidgaze

WWWGROUP=1000
WWWUSER=1000
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
SAIL_XDEBUG_MODE=off
SAIL_XDEBUG_CONFIG=client_host=host.docker.internal

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# With Sail app container: DB_HOST=mysql. PHP on host + DB in Docker: 127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vidgaze
DB_USERNAME=vidgaze_user
DB_PASSWORD=changemeplz

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

# With Sail app container: REDIS_HOST=redis. PHP on host: 127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Seconds; set higher than slowest queue job (Apify YouTube sync can run several minutes).
REDIS_QUEUE_RETRY_AFTER=900

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD="xxxx xxxx xxxx xxxx"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME=${APP_NAME}

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

APIFY_TOKEN=
# Default actor id; override if you use a fork (tilde format, e.g. streamers~youtube-scraper)
APIFY_YOUTUBE_ACTOR=streamers~youtube-scraper

# Firecrawl (Vimeo search / scrape when API is region-blocked). Also accepts FIRECRAWL_API_KEY.
FIRECRAWLER_API_KEY=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

VIDGAZE_API_KEY=
NANOGPT_API_KEY=
# Legacy api.scraper.tech key (unused if YouTube uses Apify above)
SCRAPER_KEY=

DAILYMOTION_CLIENT_KEY=
DAILYMOTION_CLIENT_SECRET=
DAILYMOTION_REDIRECT_URL=

VIMEO_DEVELOPER_KEY=
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
VIMEO_REDIRECT_URL=

GOOGLE_DEVELOPER_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL_LINK=
GOOGLE_REDIRECT_URL_IMPORT=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URL=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URL=

# Laravel AI (laravel/ai + Prism) — set keys for providers you use; see config/ai.php
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
ELEVENLABS_API_KEY=
