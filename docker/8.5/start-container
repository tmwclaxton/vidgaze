#!/usr/bin/env bash
set -e

if [ -n "$WWWUSER" ]; then
    usermod -u "$WWWUSER" sail >/dev/null 2>&1 || true
fi

mkdir -p /var/www/html/storage/logs /var/www/html/storage/framework/{cache/data,sessions,views} /var/www/html/storage/app/public
touch /var/www/html/storage/logs/laravel.log /var/www/html/storage/logs/worker.log
chown -R sail:sail /var/www/html/storage /var/www/html/bootstrap/cache
chmod -R ug+rwX /var/www/html/storage /var/www/html/bootstrap/cache

if [ "${RUN_MIGRATIONS:-false}" = "true" ]; then
    gosu sail php /var/www/html/artisan migrate --force --no-interaction
fi

if [ "${APP_ENV:-production}" = "production" ]; then
    gosu sail php /var/www/html/artisan config:cache
    gosu sail php /var/www/html/artisan route:cache || true
    gosu sail php /var/www/html/artisan view:cache
fi

if [ $# -gt 0 ]; then
    exec gosu sail "$@"
else
    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi
