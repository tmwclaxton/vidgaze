# syntax=docker/dockerfile:1

# -----------------------------------------------------------------------------
# Vendor (Composer, no dev packages)
# -----------------------------------------------------------------------------
FROM composer:2 AS vendor

WORKDIR /app
ENV COMPOSER_ALLOW_SUPERUSER=1

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-scripts --prefer-dist \
    --optimize-autoloader --ignore-platform-reqs

COPY . .
RUN composer dump-autoload --optimize --no-dev --no-scripts

# -----------------------------------------------------------------------------
# Frontend assets (Node is not present in the final image)
# -----------------------------------------------------------------------------
FROM node:22-bookworm-slim AS frontend

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
COPY --from=vendor /app/vendor/tightenco/ziggy ./vendor/tightenco/ziggy
RUN npm run build

# -----------------------------------------------------------------------------
# Runtime: PHP + Supervisor only (no Node, no Composer, no dev extensions)
# -----------------------------------------------------------------------------
FROM php:8.5.12-cli-bookworm

LABEL maintainer="VidGaze"

ARG WWWGROUP=1000
ARG WWWUSER=1337

WORKDIR /var/www/html

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV SUPERVISOR_PHP_COMMAND="/usr/bin/php -d variables_order=EGPCS /var/www/html/artisan serve --host=0.0.0.0 --port=8080 --no-reload"
ENV WWWUSER=${WWWUSER}
ENV WWWGROUP=${WWWGROUP}

COPY --from=mlocati/php-extension-installer:2 /usr/bin/install-php-extensions /usr/local/bin/

RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl gosu supervisor tzdata unzip zip \
    && ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime \
    && echo ${TZ} > /etc/timezone \
    && install-php-extensions \
        bcmath exif gd intl mysqli opcache pcntl pdo_mysql redis sockets zip \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

RUN ln -sf /usr/local/bin/php /usr/bin/php \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

RUN groupadd --force -g ${WWWGROUP} sail \
    && useradd -ms /bin/bash --no-user-group -g ${WWWGROUP} -u ${WWWUSER} sail

RUN mkdir -p /etc/supervisor/logs /var/log/supervisor

COPY docker/8.5/start-container /usr/local/bin/start-container
COPY docker/8.5/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/8.5/php.ini /usr/local/etc/php/conf.d/99-vidgaze.ini
COPY docker/8.5/workers /etc/supervisor/conf.d/workers

COPY . /var/www/html
COPY --from=vendor /app/vendor /var/www/html/vendor
COPY --from=frontend /app/public/build /var/www/html/public/build

RUN rm -f .env bootstrap/cache/*.php \
    && mkdir -p storage/logs storage/framework/cache/data storage/framework/sessions storage/framework/views storage/app/public \
    && php artisan package:discover --ansi --no-interaction \
    && php artisan storage:link --no-interaction \
    && chown -R sail:sail storage bootstrap/cache \
    && chmod +x /usr/local/bin/start-container

EXPOSE 8080/tcp

ENTRYPOINT ["start-container"]
